---
import type { HomeUi } from '~/i18n/ui';
import { visibleGameUpdates } from '~/config/editorial';

interface Props {
  copy: HomeUi['gameUpdates'];
}
const { copy } = Astro.props;
const updates = visibleGameUpdates().slice(0, 3);
---

{updates.length > 0 && (
  <section class="section border-t border-border">
    <div class="flex flex-wrap items-end justify-between gap-3">
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-nav">{copy.badge}</p>
        <h2 class="mt-2 text-2xl font-bold tracking-tight md:text-3xl">{copy.title}</h2>
        <p class="mt-2 text-sm text-muted-foreground">{copy.description}</p>
      </div>
      <a href="/updates/" class="text-sm font-semibold text-nav hover:underline">{copy.archiveLink} ↗</a>
    </div>
    <div class="mt-6 grid gap-4 md:grid-cols-3">
      {updates.map((update) => (
        <a href={`/updates/${update.slug}/`} class="card group block p-5">
          <div class="flex flex-wrap items-center gap-2 text-xs font-semibold text-muted-foreground">
            <time datetime={update.date}>{update.date}</time>
            {update.version && <span class="rounded-full bg-nav/10 px-2 py-0.5 text-nav">{update.version}</span>}
            {update.example && <span>{copy.exampleLabel}</span>}
          </div>
          <h3 class="mt-3 text-lg font-bold leading-snug group-hover:text-nav">{update.title}</h3>
          <p class="mt-2 line-clamp-3 text-sm leading-relaxed text-muted-foreground">{update.summary}</p>
        </a>
      ))}
    </div>
  </section>
)}
