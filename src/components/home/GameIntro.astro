---
import type { HomeUi } from '~/i18n/ui';
import { gameProfile } from '~/config/editorial';

interface Props {
  copy: HomeUi['gameIntro'];
}
const { copy } = Astro.props;
---

<section class="section border-t border-border">
  <div class="grid items-start gap-8 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] lg:gap-12">
    <div>
      <p class="text-xs font-bold uppercase tracking-[0.18em] text-nav">{copy.badge}</p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight md:text-3xl">{copy.title}</h2>
      <p class="mt-4 max-w-xl leading-relaxed text-muted-foreground">{copy.description}</p>
      <a href="/game/" class="mt-5 inline-flex items-center gap-2 font-semibold text-nav hover:underline">
        {copy.detailLink}<span aria-hidden="true">↗</span>
      </a>
    </div>
    <div class="grid gap-3 sm:grid-cols-3 lg:grid-cols-1">
      {[
        { label: copy.backgroundLabel, text: gameProfile.background },
        { label: copy.gameplayLabel, text: gameProfile.gameplay },
        { label: copy.audienceLabel, text: gameProfile.audience },
      ].map((item) => (
        <div class="rounded-xl border border-border bg-card p-4">
          <h3 class="text-sm font-bold text-foreground">{item.label}</h3>
          <p class="mt-1 line-clamp-2 text-sm leading-relaxed text-muted-foreground">{item.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>
