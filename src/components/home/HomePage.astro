---
/**
 * HomePage — renders the homepage from the locale JSON `home` namespace.
 *
 * Data-driven: changing src/locales/en.json updates the homepage without
 * touching this component.
 *
 * Sections (top to bottom):
 *   1. Hero          — game intro, facts, and artwork or video
 *   2. GameOverview  — flexible status, play, update, and entry cards
 *   3. Game introduction — excerpt linking to the full game page
 *   4. Game updates — published game notes, separate from wiki articles
 *   5. Recent wiki articles and developer profile
 *
 * Game updates are patch notes; Recent below them contains wiki articles.
 */
import { Icon } from 'astro-icon/components';
import LocaleLayout from '~/components/layout/LocaleLayout.astro';
import AdsterraSlot from '~/components/ads/AdsterraSlot.astro';
import LazyYouTube from '~/components/video/LazyYouTube.astro';
import GameOverview from '~/components/home/GameOverview.astro';
import GameIntro from '~/components/home/GameIntro.astro';
import GameUpdates from '~/components/home/GameUpdates.astro';
import DeveloperFeature from '~/components/home/DeveloperFeature.astro';
import { site } from '~/config/site';
import { NAVIGATION_CONFIG } from '~/config/navigation';
import { type Locale } from '~/i18n/routing';
import { getUi, type HomeUi } from '~/i18n/ui';
import { getRecentEntries, parseEntryId } from '~/lib/content';
import { listPath, detailPath, recentPath } from '~/lib/url';

interface Props {
  locale: Locale;
  jsonLd?: Record<string, unknown>[];
  /** hreflang alternates (built by the route page). */
  alternates?: Array<{ hreflang: string; href: string }>;
}
const { locale, jsonLd = [], alternates = [] } = Astro.props;
const ui = getUi(locale);
// Typed straight from en.json (HomeUi) — no `as any`: a renamed key now
// fails typecheck instead of silently blanking the block (check-i18n only
// compares locale↔en, not component↔en; tests/home-ui.test.ts pins the
// access surface at the JSON level too).
const home = ui.home;
const shared = ui.shared;

const recent = await getRecentEntries(locale, 6);

// Per-field fallbacks: a locale JSON whose meta object exists but lacks
// title/description must not pass undefined into BaseLayout (title.includes
// crashes the build) — same spirit as the ?? defaults below.
const meta = {
  title: home.meta?.title ?? site.name,
  description: home.meta?.description ?? site.description,
};
// Section namespaces come from en.json verbatim (getUi deep-merges non-en
// locales over en), so every key is guaranteed present — no per-section
// `{ cards: [] }`-style fallbacks and no hardcoded English anywhere. A key
// missing from en.json itself is a build-time typecheck failure, not a
// blanked section at runtime.
const hero: HomeUi['hero'] = home.hero;
const gameOverview: HomeUi['gameOverview'] = home.gameOverview;
const heroArtwork = '/images/' + 'hero' + '.webp';
const heroPrimaryHref = site.social.official && !site.social.official.startsWith('https://example.com')
  ? site.social.official
  : listPath(NAVIGATION_CONFIG[1]?.key ?? NAVIGATION_CONFIG[0]?.key ?? 'guides', locale);
const updates: HomeUi['updates'] = home.updates;
---

<LocaleLayout
  locale={locale}
  title={meta.title}
  description={meta.description}
  alternates={alternates}
  jsonLd={jsonLd}
>
  {/* ─────────────────────────────── Hero ─────────────────────────────── */}
  <section class="relative overflow-hidden border-b border-border">
    {/* Subtle theme-color gradient backdrop — gives the hero a visual anchor
        without requiring an image asset. Sits behind the watermark. */}
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 bg-gradient-to-br from-nav/8 via-transparent to-transparent"
    />
    {/* Faint game-name watermark — pure CSS, no image asset required. */}
    <span
      aria-hidden="true"
      class="pointer-events-none absolute inset-x-0 top-1/2 -translate-y-1/2 select-none text-center text-[18vw] font-black leading-none text-foreground/[0.03] md:text-[14vw]"
    >
      {site.game.name}
    </span>

    <div class="relative mx-auto grid w-full max-w-7xl items-center gap-10 px-4 py-12 md:grid-cols-2 md:gap-12 md:py-16 lg:py-20">
      <div class="min-w-0">
        <p class="text-sm font-semibold uppercase tracking-wider text-foreground">{hero.badge}</p>
        <h1
          class="mt-3 max-w-3xl bg-gradient-to-r from-foreground to-foreground/60 bg-clip-text text-4xl font-black tracking-tight text-transparent sm:text-5xl lg:text-6xl"
        >
          {hero.title}
        </h1>
        <p class="mt-5 max-w-xl text-base text-muted-foreground md:text-lg">{hero.description}</p>

        <dl class="mt-6 grid max-w-xl grid-cols-2 gap-3 sm:grid-cols-3">
          <div class="rounded-lg border border-border/70 bg-card/70 p-3">
            <dt class="text-xs font-medium uppercase tracking-wide text-muted-foreground">{hero.developerLabel}</dt>
            <dd class="mt-1 truncate text-sm font-semibold text-foreground">{site.game.developer}</dd>
          </div>
          <div class="rounded-lg border border-border/70 bg-card/70 p-3">
            <dt class="text-xs font-medium uppercase tracking-wide text-muted-foreground">{hero.platformLabel}</dt>
            <dd class="mt-1 truncate text-sm font-semibold text-foreground">{site.game.platform}</dd>
          </div>
          <div class="rounded-lg border border-border/70 bg-card/70 p-3">
            <dt class="text-xs font-medium uppercase tracking-wide text-muted-foreground">{hero.genreLabel}</dt>
            <dd class="mt-1 truncate text-sm font-semibold text-foreground">{site.game.genre}</dd>
          </div>
          {site.game.releaseDate && (
            <div class="rounded-lg border border-border/70 bg-card/70 p-3">
              <dt class="text-xs font-medium uppercase tracking-wide text-muted-foreground">{hero.releaseDateLabel}</dt>
              <dd class="mt-1 truncate text-sm font-semibold text-foreground">{site.game.releaseDate}</dd>
            </div>
          )}
          {site.game.playerCount && (
            <div class="rounded-lg border border-border/70 bg-card/70 p-3">
              <dt class="text-xs font-medium uppercase tracking-wide text-muted-foreground">{hero.playerCountLabel}</dt>
              <dd class="mt-1 truncate text-sm font-semibold text-foreground">{site.game.playerCount}</dd>
            </div>
          )}
        </dl>

        <div class="mt-7 flex flex-wrap gap-3">
          {hero.ctaPrimary && (
            <a href={heroPrimaryHref} class="btn-primary">
              <Icon name="lucide:play" class="mr-2 h-4 w-4" />{hero.ctaPrimary}
            </a>
          )}
          {hero.ctaSecondary && (
            <a href={recentPath(locale)} class="btn-outline">
              {hero.ctaSecondary}
            </a>
          )}
        </div>
      </div>

      <div class="relative aspect-video overflow-hidden rounded-2xl border border-border bg-card shadow-xl">
        {hero.videoId ? (
          <div class="h-full w-full">
            <LazyYouTube videoId={hero.videoId} title={`${site.game.name} ${shared.gameTrailer}`} />
          </div>
        ) : (
          <img
            src={heroArtwork}
            alt={`${site.game.name} game artwork`}
            class="h-full w-full object-cover"
            fetchpriority="high"
            width="1200"
            height="630"
          />
        )}
        <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-background/30 via-transparent to-transparent" />
      </div>
    </div>
  </section>

  {gameOverview && <GameOverview locale={locale} content={gameOverview} />}
  {/* First monetization point: below the useful hero + overview content.
      Fixed 728 creative stays desktop-only; env empty = zero DOM. */}
  <AdsterraSlot name="incontent-728x90" width={728} height={90} hideOnMobile />
  <GameIntro copy={home.gameIntro} />
  <GameUpdates copy={home.gameUpdates} />

  {/* ───────────────────── Recent wiki articles ────────────────────────── */}
  <section class="section border-t border-border">
    <div>
        <div class="flex items-baseline justify-between">
          <h2 class="text-2xl font-bold">{updates.title}</h2>
          <a href={recentPath(locale)} class="text-sm text-foreground hover:text-nav hover:underline"
            >{shared.browseAll}</a
          >
        </div>
        <div class="mt-4 grid gap-4 sm:grid-cols-2">
          {
            recent.length === 0 ? (
              <p class="text-sm text-muted-foreground">{shared.noArticles}</p>
            ) : (
              recent.map((entry) => {
                const parsed = parseEntryId(entry.id);
                if (!parsed) return null;
                return (
                  <a href={detailPath(parsed.category, parsed.slug, locale)} class="card p-4">
                    <p class="text-xs uppercase tracking-wider text-muted-foreground">
                      {parsed.category}
                    </p>
                    <h3 class="mt-1 font-semibold leading-snug">{entry.data.title}</h3>
                    <p class="mt-1 line-clamp-2 text-sm text-muted-foreground">
                      {entry.data.description}
                    </p>
                  </a>
                );
              })
            )
          }
        </div>
    </div>
  </section>

  {/* Responsive unit after the article discovery block, never inside Hero or
      between a card and its CTA. */}
  <AdsterraSlot name="native-banner" width={700} height={240} />

  <DeveloperFeature copy={home.developerFeature} />

</LocaleLayout>
