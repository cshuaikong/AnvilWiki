---
/**
 * DevGuide — the "how to use it" walkthrough: 5 numbered steps from fork to
 * a live, fresh site (run → CLI → AI authoring → deploy → freshness).
 * Complements DocsEntry (topical doc cards) with the sequential path; every
 * step links to its full doc. All copy lives in landing.ts (t.devGuide).
 */
import { Icon } from 'astro-icon/components';
import { type LandingContent } from '~/config/landing';

interface Props {
  t: LandingContent;
}
const { t } = Astro.props;
const { steps } = t.devGuide;
---

<section id="guide" class="section border-t border-border">
  <div class="mx-auto max-w-3xl">
    <h2 class="text-center text-3xl font-extrabold tracking-tight text-foreground">
      {t.devGuide.title}
    </h2>
    <p class="mx-auto mt-3 max-w-2xl text-center text-muted-foreground">
      {t.devGuide.subtitle}
    </p>

    <ol class="mt-12">
      {steps.map((step, i) => (
        <li class="relative flex gap-4 pb-10 last:pb-0 sm:gap-6">
          {i < steps.length - 1 && (
            <span
              class="absolute left-[19px] top-11 h-[calc(100%-3rem)] w-px bg-border"
              aria-hidden="true"
            />
          )}
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-nav/10 font-bold text-nav">
            {i + 1}
          </div>
          <div class="min-w-0 flex-1 pt-1">
            <h3 class="font-semibold text-foreground">{step.title}</h3>
            <p class="mt-1 text-sm text-muted-foreground">{step.description}</p>
            <div class="mt-2.5 flex flex-wrap items-center gap-x-4 gap-y-2">
              <code class="inline-block max-w-full overflow-x-auto whitespace-nowrap rounded-md bg-muted px-2 py-1 font-mono text-xs text-foreground/80">
                {step.command}
              </code>
              <a
                href={step.href}
                target="_blank"
                rel="noopener"
                class="inline-flex items-center gap-1 text-xs font-medium text-nav transition hover:underline"
              >
                <span class="border-b border-transparent transition hover:border-nav">
                  {step.linkLabel}
                </span>
                <Icon name="lucide:arrow-right" class="h-3 w-3" />
              </a>
            </div>
          </div>
        </li>
      ))}
    </ol>

    <div class="mt-4 flex justify-center border-t border-border pt-6">
      <a
        href={t.devGuide.allDocs.href}
        target={t.devGuide.allDocs.href.startsWith('http') ? '_blank' : undefined}
        rel={t.devGuide.allDocs.href.startsWith('http') ? 'noopener' : undefined}
        class="card group inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-foreground transition hover:text-nav"
      >
        <Icon name="lucide:book-open" class="h-4 w-4 text-nav" />
        <span>{t.devGuide.allDocs.label}</span>
        <Icon
          name="lucide:arrow-right"
          class="h-4 w-4 text-muted-foreground transition group-hover:translate-x-0.5 group-hover:text-nav"
        />
      </a>
    </div>
  </div>
</section>
