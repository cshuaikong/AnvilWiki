---
/**
 * SocialProofBar — Lighthouse 4×100 badges + tech stack credit.
 * Pure HTML/Tailwind (no external badge images — keeps it fast).
 */
import { type LandingContent } from '~/config/landing';

interface Props {
  t: LandingContent;
}
const { t } = Astro.props;
---

<section class="border-y border-border bg-muted/30">
  <div class="mx-auto flex max-w-7xl flex-col items-center gap-4 px-4 py-6 sm:flex-row sm:justify-center sm:gap-8">
    {/* Lighthouse scores */}
    <div class="flex items-center gap-3">
      <span class="text-sm font-semibold text-foreground">Lighthouse</span>
      <div class="flex gap-1.5">
        {t.socialProof.lighthouse.map((item) => (
          <div class="flex flex-col items-center rounded-md border border-green-500/30 bg-green-500/10 px-2 py-1">
            <span class="text-sm font-bold text-green-600 dark:text-green-400">{item.score}</span>
            <span class="text-[10px] leading-none text-muted-foreground">{item.label}</span>
          </div>
        ))}
      </div>
    </div>
    {/* Divider */}
    <div class="hidden h-8 w-px bg-border sm:block"></div>
    {/* Tech credit */}
    <p class="text-sm text-muted-foreground">{t.socialProof.poweredBy}</p>
  </div>
</section>
