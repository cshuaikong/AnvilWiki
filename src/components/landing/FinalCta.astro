---
/**
 * FinalCta — bottom call-to-action banner.
 * Big heading + subtitle + 2 CTA buttons.
 */
import { Icon } from 'astro-icon/components';
import { type LandingContent } from '~/config/landing';

interface Props {
  t: LandingContent;
}
const { t } = Astro.props;
---

<section class="section border-t border-border">
  <div class="mx-auto max-w-2xl text-center">
    <h2 class="text-3xl font-extrabold tracking-tight text-foreground sm:text-4xl">
      {t.finalCta.title}
    </h2>
    <p class="mt-3 text-lg text-muted-foreground">{t.finalCta.subtitle}</p>
    <div class="mt-7 flex flex-wrap justify-center gap-3">
      <a href={t.finalCta.primaryCta.href} class="btn-primary inline-flex items-center gap-1.5">
        <Icon name="lucide:rocket" class="h-4 w-4" />
        {t.finalCta.primaryCta.label}
      </a>
      <a
        href={t.finalCta.secondaryCta.href}
        class="btn-outline inline-flex items-center gap-1.5"
        target="_blank"
        rel="noopener"
      >
        {t.finalCta.secondaryCta.label}
      </a>
    </div>
  </div>
</section>
