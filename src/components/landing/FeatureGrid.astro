---
/**
 * FeatureGrid — 6 feature cards in a responsive grid.
 * Reuses the card styling pattern from QuickStart.astro (icon + title + desc).
 * Data-driven from t.features.
 */
import { Icon } from 'astro-icon/components';
import { type LandingContent } from '~/config/landing';

interface Props {
  t: LandingContent;
}
const { t } = Astro.props;
---

<section class="section">
  <div class="mx-auto grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {t.features.map((feature) => (
      <div class="card group flex flex-col p-5">
        <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-nav/10 text-nav">
          <Icon name={feature.icon} class="h-6 w-6" />
        </div>
        <h3 class="mt-4 font-semibold leading-snug text-foreground">{feature.title}</h3>
        <p class="mt-2 text-sm text-muted-foreground">{feature.description}</p>
      </div>
    ))}
  </div>
</section>
