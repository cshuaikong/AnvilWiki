---
/**
 * HandbookHub — the /landing/docs chooser. Shows the "whole job at a glance"
 * roadmap, then ONE card per manual linking to that manual's own page
 * (learn/dev are deliberately separate — different audiences, different
 * reading modes: linear course vs. lookup reference).
 */
import { Icon } from 'astro-icon/components';
import { type LandingContent } from '~/config/landing';
import { handbookPath, type HandbookEntry, type HandbookManual } from '~/lib/handbook';

interface Props {
  chapters: HandbookEntry[];
  locale: 'en' | 'zh';
  t: LandingContent;
}
const { chapters, locale, t } = Astro.props;
const manuals: HandbookManual[] = ['learn', 'dev'];
const manualIcons: Record<HandbookManual, string> = {
  learn: 'lucide:graduation-cap',
  dev: 'lucide:wrench',
};
const count = (m: HandbookManual) => chapters.filter((c) => c.data.manual === m).length;
---

<section class="section">
  <div class="mx-auto max-w-5xl">
    <h1 class="text-3xl font-extrabold tracking-tight text-foreground sm:text-4xl">
      {t.handbook.hubTitle}
    </h1>
    <p class="mx-auto mt-4 max-w-3xl text-muted-foreground">{t.handbook.hubSubtitle}</p>

    {/* Explicit "start here" pill for complete beginners */}
    <div class="mt-5">
      <a
        href={t.handbook.beginnerHint.href}
        class="inline-flex items-center gap-2 rounded-full border border-nav/30 bg-nav/5 px-4 py-1.5 text-sm font-medium text-nav transition hover:bg-nav/10"
      >
        <Icon name="lucide:flag" class="h-4 w-4" />
        {t.handbook.beginnerHint.text}
        <Icon name="lucide:arrow-right" class="h-4 w-4" />
      </a>
    </div>

    {/* The whole job at a glance — every step links to its chapter */}
    <div class="mt-10 rounded-lg border border-border bg-card p-5 sm:p-6">
      <h2 class="text-lg font-bold text-foreground">{t.handbook.roadmap.title}</h2>
      <p class="mt-1 text-sm text-muted-foreground">{t.handbook.roadmap.hint}</p>
      <ol class="mt-5 grid gap-2 sm:grid-cols-2">
        {t.handbook.roadmap.items.map((item, i) => (
          <li>
            <a
              href={item.href}
              class="group flex items-center gap-3 rounded-md px-2 py-1.5 transition hover:bg-muted"
            >
              <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-nav/10 text-xs font-bold text-nav">
                {i + 1}
              </span>
              <span class="min-w-0 flex-1 truncate text-sm text-foreground transition group-hover:text-nav">
                {item.label}
              </span>
              <span class="shrink-0 text-xs text-muted-foreground">{item.time}</span>
            </a>
          </li>
        ))}
      </ol>
    </div>

    {/* One card per manual → its own page */}
    <div class="mt-10 grid gap-5 md:grid-cols-2">
      {manuals.map((manual) => (
        <a href={handbookPath(locale, manual)} class="card group flex flex-col p-6">
          <div class="flex items-center gap-3">
            <div class="flex h-11 w-11 items-center justify-center rounded-lg bg-nav/10 text-nav">
              <Icon name={manualIcons[manual]} class="h-6 w-6" />
            </div>
            <h2 class="text-lg font-bold text-foreground">{t.handbook.manuals[manual].label}</h2>
            <span class="ml-auto rounded-full border border-border px-2.5 py-0.5 text-xs text-muted-foreground">
              {count(manual)} {t.handbook.chaptersCountLabel}
            </span>
          </div>
          <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
            {t.handbook.manuals[manual].description}
          </p>
          <span class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-nav">
            <span class="border-b border-transparent transition group-hover:border-nav">
              {t.handbook.openManualLabel}
            </span>
            <Icon
              name="lucide:arrow-right"
              class="h-4 w-4 transition group-hover:translate-x-0.5"
            />
          </span>
        </a>
      ))}
    </div>
  </div>
</section>
