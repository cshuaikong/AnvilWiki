---
/**
 * CompareTable — "Why AnvilWiki?" comparison table.
 * AnvilWiki column is highlighted. Wrapped in overflow-x-auto for mobile
 * (fixes the mobile table overflow issue flagged by the UX expert).
 */
import { type LandingContent } from '~/config/landing';

interface Props {
  t: LandingContent;
}
const { t } = Astro.props;
---

<section class="section border-t border-border">
  <div class="mx-auto max-w-4xl">
    <h2 class="text-center text-3xl font-extrabold tracking-tight text-foreground">
      {t.compare.title}
    </h2>
    <p class="mt-2 text-center text-muted-foreground">{t.compare.subtitle}</p>

    <div class="mt-8 overflow-x-auto">
      <table class="w-full border-collapse text-sm">
        <thead>
          <tr class="border-b border-border">
            <th class="p-3 text-left text-xs font-semibold uppercase tracking-wider text-muted-foreground"></th>
            {t.compare.columns.map((col, i) => (
              <th
                class:list={[
                  'p-3 text-center font-semibold',
                  i === 0
                    ? 'rounded-t-lg bg-nav/10 text-nav'
                    : 'text-foreground',
                ]}
              >
                {col}
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {t.compare.rows.map((row) => (
            <tr class="border-b border-border/50">
              <td class="p-3 text-left font-medium text-muted-foreground">{row.label}</td>
              {row.values.map((value, i) => (
                <td
                  class:list={[
                    'p-3 text-center',
                    i === 0 ? 'bg-nav/5 font-medium text-foreground' : 'text-muted-foreground',
                  ]}
                >
                  {value}
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <p class="mt-4 text-center text-sm">
      <a href={t.compare.full.href} class="font-medium text-nav transition hover:underline">
        {t.compare.full.label}
      </a>
    </p>
  </div>
</section>
