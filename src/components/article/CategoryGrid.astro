---
/**
 * Category card grid — the article list part of a category page.
 *
 * ListPage renders this grid once, after the category introduction slot.
 * Category index.mdx authors only supply prose, not another grid instance.
 * Other page components may reuse the grid without the full ListPage shell.
 *
 * Renders the empty state when the category has no articles yet — the same
 * box ListPage has always shown.
 */
import { Icon } from 'astro-icon/components';
import ArticleCover from '~/components/article/ArticleCover.astro';
import { type Locale } from '~/i18n/routing';
import type { WikiEntry } from '~/i18n/content';
import { getUi } from '~/i18n/ui';
import { getEntriesByCategory, parseEntryId } from '~/lib/content';
import { detailPath } from '~/lib/url';

interface Props {
  locale: Locale;
  category: string;
  /**
   * Already resolved by ListPage, which needs the same list for its JSON-LD and
   * its noindex decision. Other page components may omit it to load the
   * category through the same accessor ListPage uses.
   */
  entries?: WikiEntry[];
}
const { locale, category, entries } = Astro.props;
const list = entries ?? (await getEntriesByCategory(category, locale));
const shared = getUi(locale).shared;
---

{
  list.length === 0 ? (
    <div class="rounded-lg border border-dashed bg-card p-12 text-center">
      <Icon name="lucide:inbox" class="mx-auto h-10 w-10 text-muted-foreground" />
      <p class="mt-3 text-muted-foreground">{shared.noArticles}</p>
    </div>
  ) : (
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {list.map((entry) => {
        const slug = parseEntryId(entry.id)?.slug ?? '';
        return (
          <a href={detailPath(category, slug, locale)} class="card p-5">
            {entry.data.image && <ArticleCover src={entry.data.image} />}
            <h2 class="font-semibold leading-snug">{entry.data.title}</h2>
            <p class="mt-1 line-clamp-2 text-sm text-muted-foreground">
              {entry.data.description}
            </p>
            <p class="mt-3 text-xs text-muted-foreground">
              {entry.data.lastModified
                ? `${shared.lastUpdated}: ${entry.data.lastModified.toLocaleDateString(locale, { timeZone: 'UTC' })}`
                : `${shared.publishedOn}: ${entry.data.date.toLocaleDateString(locale, { timeZone: 'UTC' })}`}
            </p>
          </a>
        );
      })}
    </div>
  )
}
