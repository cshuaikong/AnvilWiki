---
/**
 * List page — shows all articles in a category for a locale.
 *
 * Behavior (PRD §9.3): does NOT fall back to English. If the locale has
 * no articles in this category, the empty state is shown.
 */
import { Icon } from 'astro-icon/components';
import LocaleLayout from '~/components/layout/LocaleLayout.astro';
import CategoryGrid from '~/components/article/CategoryGrid.astro';
import CodesTable from '~/components/article/CodesTable.astro';
import { NAVIGATION_CONFIG } from '~/config/navigation';
import { type Locale } from '~/i18n/routing';
import { getUi } from '~/i18n/ui';
import { getEntriesByCategory, parseEntryId } from '~/lib/content';
import { faqPageJsonLd, itemListJsonLd, pageTitle, simpleBreadcrumbJsonLd } from '~/lib/seo';
import { homeUrl, listPath } from '~/lib/url';

interface Props {
  locale: Locale;
  category: string;
  /** hreflang alternates (built by the route page). */
  alternates?: Array<{ hreflang: string; href: string }>;
  /**
   * Whether this category ships an `index.mdx` landing body (resolved by the
   * route page). Feeds the noindex decision below: a category with real prose
   * but no articles yet is NOT the thin empty state this flag exists for.
   */
  hasIndex?: boolean;
  /** Structured frontmatter from category index.mdx (used by single-page sections). */
  indexData?: {
    lastModified?: Date;
    summary?: string;
    codes?: Array<{
      code: string;
      reward?: string;
      status: 'active' | 'expired';
      expiryDate?: string;
      source?: string;
    }>;
    faq?: Array<{ question: string; answer: string }>;
  };
}
const { locale, category, alternates = [], hasIndex = false, indexData } = Astro.props;
const ui = getUi(locale);
const nav = ui.nav as Record<string, string>;
const shared = ui.shared;
const overview = (
  ui.overview as Record<string, { overviewTitle: string; overviewDescription: string }>
)[category];
const navItem = NAVIGATION_CONFIG.find((n) => n.key === category);

const title = overview?.overviewTitle ?? nav[category] ?? category;
// Localized default (locale JSON shared.defaultListDescription) — a hardcoded
// English sentence here would leak into every locale the moment a fork adds
// a 5th category without an overview entry. `|| title` (not ??) so an empty
// locale string genuinely falls back to the bare title.
const description =
  overview?.overviewDescription ??
  (String(shared.defaultListDescription ?? '').replace('{title}', title) || title);

const entries = await getEntriesByCategory(category, locale);
const singlePage = navItem?.singlePage === true;
const landingCodes = indexData?.codes ?? [];
const landingFaq = indexData?.faq ?? [];

const jsonLd = [
  // Empty ItemList (itemListElement: []) is invalid structured data — only
  // inject when the list actually has entries (breadcrumb stays either way).
  ...(entries.length > 0
    ? [
        itemListJsonLd({
          category,
          categoryLabel: title,
          locale,
          items: entries.map((e) => {
            const slug = parseEntryId(e.id)?.slug ?? '';
            return { title: e.data.title, slug };
          }),
        }),
      ]
    : []),
  simpleBreadcrumbJsonLd({
    pageLabel: title,
    path: listPath(category, locale),
    locale,
    homeLabel: nav.home,
  }),
  ...(landingFaq.length > 0 ? [faqPageJsonLd(landingFaq)] : []),
];
---

{/* A category with no articles and no landing prose is a ~100-word
     thin-content page (NMS /starships was indexed as one). noindex keeps it out
     of Google until real content exists; the sitemap filter excludes the same
     paths (astro.config.ts). A category that ships index.mdx prose is NOT thin
     — it stays indexable with an empty grid.

     Astro-expression comment on purpose: an HTML `<!-- -->` here would ship
     the note into every category page's markup. */}
<LocaleLayout
  locale={locale}
  title={pageTitle(title)}
  description={description}
  alternates={alternates}
  jsonLd={jsonLd}
  noindex={entries.length === 0 && !hasIndex}
>
  <div class="space-y-6">
    <header>
      <nav class="text-sm text-muted-foreground" aria-label={shared.breadcrumbAria ?? 'Breadcrumb'}>
        <a href={homeUrl(locale)} class="hover:text-nav">{nav.home}</a>
        <span class="mx-1">/</span>
        <span class="text-foreground">{title}</span>
      </nav>
      <div class="mt-2 flex items-center gap-3">
        {navItem && <Icon name={navItem.icon} class="h-7 w-7 text-nav" />}
        <h1 class="text-3xl font-extrabold tracking-tight">{title}</h1>
      </div>
      <p class="mt-2 max-w-2xl text-muted-foreground">{description}</p>
      {singlePage && indexData?.lastModified && (
        <p class="mt-3 inline-flex items-center gap-1 text-xs text-muted-foreground">
          <Icon name="lucide:refresh-cw" class="h-3.5 w-3.5" />
          {shared.lastUpdated}: {indexData.lastModified.toLocaleDateString(locale, { timeZone: 'UTC' })}
        </p>
      )}
    </header>

    {singlePage && indexData?.summary && (
      <aside class="rounded-lg border-l-4 border-nav bg-nav/5 p-4">
        <div class="flex items-start gap-2">
          <Icon name="lucide:lightbulb" class="mt-0.5 h-4 w-4 shrink-0 text-nav" />
          <div>
            <p class="text-xs font-semibold uppercase tracking-wider text-foreground">{shared.quickAnswer}</p>
            <p class="mt-1 text-sm text-foreground">{indexData.summary}</p>
          </div>
        </div>
      </aside>
    )}

    {singlePage && landingCodes.length > 0 && (
      <CodesTable codes={landingCodes} copiedText={shared.copied} labels={shared.codesTable} />
    )}

    {singlePage && landingCodes.length === 0 && (
      <section class="rounded-xl border border-border bg-card p-6">
        <p class="text-xs font-bold uppercase tracking-[0.16em] text-nav">Verified status</p>
        <h2 class="mt-2 text-xl font-bold">No verified active codes</h2>
        <p class="mt-2 text-sm leading-6 text-muted-foreground">
          No official game-specific codes have been confirmed from a verified source yet.
        </p>
      </section>
    )}

    {/* Category landing prose: the body of
        src/content/wiki/<locale>/<category>/index.mdx, when that file exists.
        No file (no slot content) → this page is exactly the list it always was. */}
    {singlePage ? <div class="prose prose-slate max-w-none dark:prose-invert"><slot /></div> : <slot />}

    {singlePage && landingFaq.length > 0 && (
      <section class="border-t border-border pt-8" aria-label={shared.codesFaqTitle}>
        <h2 class="text-xl font-bold">{shared.codesFaqTitle}</h2>
        <div class="mt-4 space-y-2">
          {landingFaq.map((item) => (
            <details class="group rounded-lg border border-border bg-card">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-2 px-4 py-3 text-sm font-semibold [&::-webkit-details-marker]:hidden">
                {item.question}
                <Icon name="lucide:chevron-down" class="h-4 w-4 text-muted-foreground transition-transform group-open:rotate-180" />
              </summary>
              <div class="border-t border-border px-4 py-3 text-sm text-foreground">{item.answer}</div>
            </details>
          ))}
        </div>
      </section>
    )}

    {!navItem?.singlePage && <CategoryGrid locale={locale} category={category} entries={entries} />}
  </div>
</LocaleLayout>
