---
import { Icon } from 'astro-icon/components';
import LocaleLayout from '~/components/layout/LocaleLayout.astro';
import AdsterraSlot from '~/components/ads/AdsterraSlot.astro';
import { gameProfile } from '~/config/editorial';
import { site } from '~/config/site';
import { defaultLocale } from '~/i18n/routing';
import { getUi } from '~/i18n/ui';

const copy = getUi(defaultLocale).home.gameIntro;
const relatedGuides = [
  {
    title: 'Beginner guide',
    text: `Learn the verified ${site.game.name} basics and follow a practical first-session order.`,
    href: '/guides/getting-started/',
    icon: 'lucide:route',
  },
  {
    title: 'Controls',
    text: 'Find the current PC and mobile control checklists without relying on guessed combat keys.',
    href: '/controls/',
    icon: 'lucide:gamepad-2',
  },
  {
    title: 'Combat systems',
    text: 'Explore guards, slips, stamina, counters, knockdowns, and the facts that still need testing.',
    href: '/combat/',
    icon: 'lucide:shield',
  },
  {
    title: 'Codes status',
    text: `Check whether any official ${site.game.name} codes or a verified redemption process are available.`,
    href: '/codes/',
    icon: 'lucide:ticket',
  },
];
---

<LocaleLayout
  locale={defaultLocale}
  title={`${site.game.name} Game Overview | ${site.name}`}
  description="Learn what First Person Boxing is, how its Roblox matches work, which devices it supports, its verified combat systems, and what still needs testing."
>
  <article class="mx-auto max-w-6xl">
    <header class="grid gap-8 border-b border-border pb-10 lg:grid-cols-[minmax(0,1fr)_20rem] lg:items-end">
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-nav">{copy.badge}</p>
        <h1 class="mt-2 text-4xl font-black tracking-tight md:text-5xl">{site.game.name}</h1>
        <p class="mt-5 max-w-3xl text-lg leading-relaxed text-muted-foreground">{copy.description}</p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a
            href={site.social.official}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-lg bg-nav px-5 py-3 font-semibold text-white hover:opacity-90"
          >
            <Icon name="lucide:play" class="h-4 w-4" /> Play on Roblox
          </a>
          <a href="/guides/getting-started/" class="inline-flex items-center gap-2 rounded-lg border border-border bg-card px-5 py-3 font-semibold hover:border-nav/50">
            Start with the beginner guide <Icon name="lucide:arrow-right" class="h-4 w-4" />
          </a>
        </div>
      </div>
      <aside class="rounded-2xl border border-border bg-muted/30 p-5">
        <p class="text-xs font-bold uppercase tracking-wider text-muted-foreground">Source status</p>
        <p class="mt-2 font-semibold">Official Roblox listing checked</p>
        <p class="mt-1 text-sm text-muted-foreground">Last verified {gameProfile.lastVerified}</p>
        <a href={site.social.official} target="_blank" rel="noopener noreferrer" class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-nav hover:underline">
          View official experience <Icon name="lucide:external-link" class="h-4 w-4" />
        </a>
      </aside>
    </header>

    <section class="py-10">
      <div class="max-w-3xl">
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-nav">Official facts</p>
        <h2 class="mt-2 text-3xl font-bold tracking-tight">First Person Boxing at a glance</h2>
        <p class="mt-3 leading-7 text-muted-foreground">These details come from the official Roblox experience record and were checked on {gameProfile.lastVerified}. Live popularity numbers are excluded because they change continuously.</p>
      </div>
      <dl class="mt-6 grid gap-px overflow-hidden rounded-2xl border border-border bg-border sm:grid-cols-2 lg:grid-cols-4">
        {gameProfile.facts.map((fact) => (
          <div class="min-w-0 bg-card p-5">
            <dt class="text-xs font-bold uppercase tracking-wider text-muted-foreground">{fact.label}</dt>
            <dd class="mt-2 break-words font-semibold leading-snug text-foreground">{fact.value}</dd>
          </div>
        ))}
      </dl>
    </section>

    {/* The first ad follows the complete official-facts block, so the page
        answers the primary search intent before monetization. */}
    <AdsterraSlot name="incontent-728x90" width={728} height={90} hideOnMobile />

    <section class="grid gap-8 border-t border-border py-10 lg:grid-cols-[0.8fr_1.2fr]">
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-nav">{copy.backgroundLabel}</p>
        <h2 class="mt-2 text-3xl font-bold tracking-tight">What kind of game is First Person Boxing?</h2>
      </div>
      <div class="space-y-5 text-base leading-8 text-muted-foreground">
        <p>{gameProfile.background}</p>
        <p>{gameProfile.gameplay}</p>
        <p>{gameProfile.audience}</p>
      </div>
    </section>

    <section class="border-t border-border py-10">
      <div class="max-w-3xl">
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-nav">Core systems</p>
        <h2 class="mt-2 text-3xl font-bold tracking-tight">How does First Person Boxing play?</h2>
        <p class="mt-3 leading-7 text-muted-foreground">The official description names the systems below. Exact inputs, percentages, damage values, and timing windows are kept out until they can be verified in the current game.</p>
      </div>
      <div class="mt-6 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {gameProfile.mechanics.map((mechanic, index) => (
          <article class="rounded-xl border border-border bg-card p-5 shadow-sm">
            <span class="flex h-8 w-8 items-center justify-center rounded-full bg-nav/10 text-sm font-bold text-nav">{index + 1}</span>
            <h3 class="mt-4 text-lg font-bold">{mechanic.title}</h3>
            <p class="mt-2 text-sm leading-6 text-muted-foreground">{mechanic.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="grid gap-6 border-t border-border py-10 lg:grid-cols-2">
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-nav">Ways to play</p>
        <h2 class="mt-2 text-3xl font-bold tracking-tight">Player matches or AI practice</h2>
        <div class="mt-5 space-y-3">
          {gameProfile.playOptions.map((option) => (
            <div class="rounded-xl border border-border bg-card p-5">
              <h3 class="font-bold">{option.title}</h3>
              <p class="mt-1 text-sm leading-6 text-muted-foreground">{option.text}</p>
            </div>
          ))}
        </div>
      </div>
      <div class="rounded-2xl border border-border bg-muted/30 p-6">
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-nav">Device support</p>
        <h2 class="mt-2 text-2xl font-bold">Where can you play?</h2>
        <p class="mt-3 leading-7 text-muted-foreground">The official description lists PC, mobile, and console. Combat prompts and physical inputs can differ, so the current in-game interface remains the source for device-specific controls.</p>
        <div class="mt-5 flex flex-wrap gap-2">
          {['PC', 'Mobile', 'Console', 'Roblox'].map((device) => (
            <span class="rounded-full border border-border bg-card px-3 py-1.5 text-sm font-semibold">{device}</span>
          ))}
        </div>
        <a href="/controls/" class="mt-5 inline-flex items-center gap-1 font-semibold text-nav hover:underline">Compare control guides <Icon name="lucide:arrow-right" class="h-4 w-4" /></a>
      </div>
    </section>

    <section class="border-t border-border py-10">
      <div class="max-w-3xl">
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-nav">Evidence check</p>
        <h2 class="mt-2 text-3xl font-bold tracking-tight">What is verified, and what still needs testing?</h2>
        <p class="mt-3 leading-7 text-muted-foreground">This separation keeps general fighting-game assumptions and information from similarly named Roblox games out of the First Person Boxing guides.</p>
      </div>
      <div class="mt-6 grid gap-4 lg:grid-cols-2">
        <div class="rounded-2xl border border-border bg-card p-6">
          <div class="flex items-center gap-2 text-nav"><Icon name="lucide:badge-check" class="h-5 w-5" /><h3 class="text-lg font-bold text-foreground">Verified from official sources</h3></div>
          <ul class="mt-4 space-y-3 text-sm leading-6 text-muted-foreground">
            {gameProfile.verified.map((item) => <li class="flex gap-2"><span class="text-nav">✓</span><span>{item}</span></li>)}
          </ul>
        </div>
        <div class="rounded-2xl border border-border bg-card p-6">
          <div class="flex items-center gap-2 text-nav"><Icon name="lucide:flask-conical" class="h-5 w-5" /><h3 class="text-lg font-bold text-foreground">Needs current in-game evidence</h3></div>
          <ul class="mt-4 space-y-3 text-sm leading-6 text-muted-foreground">
            {gameProfile.needsTesting.map((item) => <li class="flex gap-2"><span class="text-nav">•</span><span>{item}</span></li>)}
          </ul>
        </div>
      </div>
    </section>

    <AdsterraSlot name="native-banner" width={700} height={240} />

    <section class="border-t border-border py-10">
      <div class="max-w-3xl">
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-nav">Keep exploring</p>
        <h2 class="mt-2 text-3xl font-bold tracking-tight">Choose your next First Person Boxing guide</h2>
      </div>
      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        {relatedGuides.map((guide) => (
          <a href={guide.href} class="group rounded-xl border border-border bg-card p-5 shadow-sm hover:border-nav/50">
            <div class="flex items-start gap-3">
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-nav/10 text-nav"><Icon name={guide.icon} class="h-5 w-5" /></span>
              <div>
                <h3 class="font-bold group-hover:text-nav">{guide.title}</h3>
                <p class="mt-1 text-sm leading-6 text-muted-foreground">{guide.text}</p>
              </div>
            </div>
          </a>
        ))}
      </div>
      <div class="mt-8 flex flex-wrap gap-4 border-t border-border pt-6 text-sm font-semibold text-nav">
        <a href="/developer/" class="hover:underline">{copy.developerLink} ↗</a>
        <a href={site.social.official} target="_blank" rel="noopener noreferrer" class="hover:underline">Official Roblox page ↗</a>
      </div>
    </section>
  </article>
</LocaleLayout>
