---
import LocaleLayout from '~/components/layout/LocaleLayout.astro';
import { developerProfile } from '~/config/editorial';
import { site } from '~/config/site';
import { defaultLocale } from '~/i18n/routing';
import { getUi } from '~/i18n/ui';

const copy = getUi(defaultLocale).home.developerFeature;
---

<LocaleLayout
  locale={defaultLocale}
  title={`${site.game.developer} — Developer Profile | ${site.name}`}
  description={developerProfile.description}
>
  <div class="mx-auto max-w-4xl">
    <p class="text-xs font-bold uppercase tracking-[0.18em] text-nav">{copy.badge}</p>
    <h1 class="mt-2 text-4xl font-black tracking-tight md:text-5xl">{site.game.developer}</h1>
    <p class="mt-5 text-lg leading-relaxed text-muted-foreground">{developerProfile.description}</p>
    {developerProfile.games.length > 0 && (
      <section class="mt-10">
        <h2 class="text-2xl font-bold">{copy.gamesLabel}</h2>
        <div class="mt-5 grid gap-4 sm:grid-cols-2">
          {developerProfile.games.map((game) => (
            <a href={game.href} class="card block p-5">
              <h3 class="text-lg font-semibold">{game.name}</h3>
              <p class="mt-1 text-sm text-muted-foreground">{game.description}</p>
              <span class="mt-4 inline-block text-sm font-semibold text-nav">Game details ↗</span>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>
</LocaleLayout>
