# ─── Site configuration ──────────────────────────────────────────────
# Absolute site URL — MUST include https:// protocol (Astro validates as URL).
# Used for sitemap, og:image, robots. Example: https://your-domain.wiki
# For production deployment: see docs/deployment.md (wrangler.toml vs dashboard)
SITE_URL=https://your-domain.wiki

# ─── IndexNow (legacy override; new forks need no env var) ────────────
# Initialize AnvilWiki / pnpm apply-template generates .indexnow-key once and
# commits it with the fork. Existing env-backed sites may keep this fallback.
# 8-128 chars: A-Z, a-z, 0-9, or hyphen.
INDEXNOW_KEY=

# ─── Adsterra (optional, off by default) ─────────────────────────────
# One env var per slot; empty = the slot renders nothing. Each enabled slot
# ALSO needs public/ads/<name>.html holding the unit's snippet from the
# Adsterra dashboard — the iframe mounts that file.
# Naming: PUBLIC_ADSTERRA_SLOT_<NAME> where <NAME> is the html filename stem
# upper-cased with hyphens as underscores (sidebar-300x250 → SIDEBAR_300X250).
# Pattern and sandbox rationale: docs/ads.md 「广告位怎么挂」.
PUBLIC_ADSTERRA_SLOT_SIDEBAR_300X250=
PUBLIC_ADSTERRA_SLOT_INCONTENT_728X90=
PUBLIC_ADSTERRA_SLOT_NATIVE_BANNER=
PUBLIC_ADSTERRA_SOCIAL_BAR=
PUBLIC_ADSTERRA_SLOT_SIDEBAR_160X300=
PUBLIC_ADSTERRA_SLOT_SIDEBAR_160X600=

# ─── Sponsor / donation card (optional, off by default) ─────────────
# Leave PUBLIC_SPONSOR_URL empty to disable the sponsor card entirely.
# Set it to any donation page (Ko-fi / 爱发电 / GitHub Sponsors).
# PUBLIC_SPONSOR_IMAGE_URL (optional) renders a QR/banner image on the card.
PUBLIC_SPONSOR_URL=
PUBLIC_SPONSOR_IMAGE_URL=

# ─── Analytics (optional) ────────────────────────────────────────────
# Google Analytics (cookie-based — loads immediately when PUBLIC_GA_ID is set).
PUBLIC_GA_ID=
# Cloudflare Web Analytics (cookieless).
# Get the token: Cloudflare dashboard → your domain → Web Analytics → manage.
PUBLIC_CF_BEACON_TOKEN=

# ─── Google Search Console verification (optional) ──────────────────
PUBLIC_GSC_VERIFICATION=

# ─── Giscus comments (optional) ──────────────────────────────────────
# Leave empty to disable comments (default — preserves Lighthouse 4×100).
# Fill the 4 required fields below (REPO/REPO_ID/CATEGORY/CATEGORY_ID) to enable
# Giscus comments on article pages. MAPPING has a sane default (pathname).
# Get these from https://giscus.app after configuring your repo:
#   1. Repo must be PUBLIC with Discussions enabled
#   2. Install the giscus app from the config page
# See docs/comments.md for step-by-step guide.
PUBLIC_GISCUS_REPO=
PUBLIC_GISCUS_REPO_ID=
PUBLIC_GISCUS_CATEGORY=
PUBLIC_GISCUS_CATEGORY_ID=
PUBLIC_GISCUS_MAPPING=pathname
